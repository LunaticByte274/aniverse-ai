
import { NextResponse } from "next/server";

export const runtime = "nodejs";

export async function POST(request: Request) {
  const apiKey = process.env.OLLAMA_API_KEY;
  const model = process.env.OLLAMA_MODEL || "gpt-oss:20b";

  if (!apiKey) {
    return NextResponse.json(
      { error: "Ollama Cloud is not configured. Add OLLAMA_API_KEY to the web app's environment file and restart the server." },
      { status: 503 }
    );
  }

  try {
    const body = await request.json();

    const question =
      typeof body.question === "string" ? body.question.trim() : "";
    const anime =
      typeof body.anime === "string" ? body.anime.trim() : "";
    const spoilerMode = body.spoilerMode === "allow" ? "allow" : "avoid";
    const mode = [
      "lore",
      "character",
      "power",
      "ending",
      "recommend",
    ].includes(body.mode)
      ? body.mode
      : "lore";

    if (!question || question.length > 3000) {
      return NextResponse.json(
        { error: "Enter a question (maximum 3,000 characters)." },
        { status: 400 }
      );
    }

    const system = `You are ANIVERSE AI, an anime discussion assistant. Answer clearly and engagingly. Do not invent official facts, quotes, episode numbers, or citations. Distinguish confirmed canon from interpretation and fan theory. If unsure, say so.
${spoilerMode === "avoid"
  ? "STRICT SPOILER PROTECTION: do not reveal events beyond the user's stated progress. If progress is unknown, keep the answer spoiler-light and ask what episode they have reached before discussing major reveals."
  : "The user has explicitly allowed spoilers; label major spoilers clearly before revealing them."}
The requested mode is ${mode}. This app does not provide verified source retrieval, so never pretend you checked sources or cite fake URLs. If a claim needs verification, say it should be checked against official material.`;

    const user = `${anime ? `Anime context: ${anime}\n` : ""}Spoiler setting: ${spoilerMode === "avoid" ? "avoid spoilers" : "spoilers allowed"}\nQuestion: ${question}`;

    const response = await fetch("https://ollama.com/api/chat", {
      method: "POST",
      headers: {
        Authorization: `Bearer ${apiKey}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        model,
        stream: false,
        messages: [
          { role: "system", content: system },
          { role: "user", content: user },
        ],
        options: { temperature: 0.5 },
      }),
      signal: AbortSignal.timeout(60000),
    });

    const data = await response.json().catch(() => null);

    if (!response.ok) {
      const message =
        data?.error ||
        (response.status === 401
          ? "Ollama Cloud authentication failed. Check your API key."
          : response.status === 429
            ? "Ollama Cloud rate limit or usage limit reached. Try again later."
            : "The Ollama Cloud request failed.");

      return NextResponse.json(
        { error: message },
        { status: response.status === 429 ? 429 : 502 }
      );
    }

    const answer = data?.message?.content;

    if (typeof answer !== "string" || !answer.trim()) {
      return NextResponse.json(
        { error: "The AI returned an empty answer. Try again." },
        { status: 502 }
      );
    }

    return NextResponse.json({
      answer: answer.trim(),
      model,
      groundedSources: false,
    });
  } catch (error) {
    const timedOut =
      error instanceof Error &&
      (error.name === "TimeoutError" || error.name === "AbortError");

    return NextResponse.json(
      {
        error: timedOut
          ? "The AI request timed out. Try again."
          : "Could not process the AI request. Check the server log and try again.",
      },
      { status: timedOut ? 504 : 500 }
    );
  }
}
