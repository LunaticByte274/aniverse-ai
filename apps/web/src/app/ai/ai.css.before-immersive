.ai-shell{min-height:100vh;background:#090911;color:#f5f3ff;font-family:Arial,Helvetica,sans-serif}.ai-topbar{height:70px;border-bottom:1px solid #242238;display:flex;align-items:center;justify-content:space-between;padding:0 4vw;gap:20px}.ai-back{color:#c4bddf;text-decoration:none;display:flex;align-items:center;gap:8px;font-size:13px}.ai-logo{font-weight:800;letter-spacing:-.5px}.ai-logo b{color:#b49aff}.ai-logo span{display:inline-flex;padding:8px;border-radius:12px;background:#7651d6;margin-right:8px;vertical-align:middle}.ai-status{font-size:12px;color:#aaa4c5}.ai-status i{display:inline-block;width:7px;height:7px;background:#60d8a6;border-radius:50%;margin-right:7px}.ai-layout{max-width:1360px;margin:auto;padding:54px 4vw;display:grid;grid-template-columns:minmax(250px,.8fr) minmax(0,1.2fr);gap:48px}.ai-eyebrow{display:flex;gap:8px;align-items:center;color:#bba3ff;font-size:11px;font-weight:800;letter-spacing:2px}.ai-intro h1{font-size:clamp(42px,5vw,68px);letter-spacing:-3px;line-height:1.02;margin:24px 0}.ai-intro h1 span{color:#b49aff}.ai-intro>p{color:#a9a4c0;line-height:1.8;max-width:400px}.ai-safety{display:flex;gap:12px;align-items:flex-start;margin-top:34px;padding:16px;border:1px solid #30284d;background:#131020;border-radius:14px;color:#bda8ff}.ai-safety span{display:grid;gap:6px}.ai-safety strong{font-size:13px}.ai-safety small{color:#9b95b4;line-height:1.6}.ai-chat{border:1px solid #2a2740;background:#0e0d18;border-radius:20px;overflow:hidden;min-width:0}.ai-settings{padding:18px;display:grid;grid-template-columns:1fr 1fr;gap:12px;border-bottom:1px solid #28243c}.ai-settings label{display:grid;gap:7px;color:#aaa3c5;font-size:11px}.ai-settings label:first-child{grid-column:1/-1}.ai-settings input,.ai-settings select{background:#171524;color:#f2edff;border:1px solid #343049;border-radius:9px;padding:11px;min-width:0}.ai-settings .ai-progress{grid-column:1/-1}.ai-messages{padding:20px;min-height:390px;max-height:56vh;overflow:auto}.ai-welcome{text-align:center;padding:25px 0}.ai-orb{width:62px;height:62px;display:grid;place-items:center;margin:auto;border-radius:20px;color:#d9c9ff;background:linear-gradient(135deg,#7c54e5,#332258);box-shadow:0 0 50px #6945b633}.ai-welcome h2{font-size:23px;margin:18px 0 8px}.ai-welcome>p{color:#9f99b8;font-size:13px}.ai-prompts{display:grid;gap:9px;margin-top:24px;text-align:left}.ai-prompts button{display:flex;justify-content:space-between;align-items:center;gap:12px;background:#151321;border:1px solid #302b45;border-radius:11px;padding:13px;color:#d8d1ef;text-align:left;cursor:pointer;font-size:12px}.ai-prompts button:hover{border-color:#8f72e7}.ai-prompts button span{color:#b49aff}.ai-message{padding:14px 16px;margin:12px 0;border-radius:12px;line-height:1.7;white-space:pre-wrap}.ai-message.user{background:#211a36;margin-left:8%}.ai-message.assistant{background:#141321;border:1px solid #2a263e;margin-right:4%}.ai-message>span{font-size:10px;font-weight:800;letter-spacing:1.3px;color:#bba4ff}.ai-message p{font-size:13px;color:#e1dced;margin:8px 0 0}.ai-thinking{display:flex;gap:8px;align-items:center;color:#bba4ff;font-size:12px;padding:14px}.ai-error{margin:10px;padding:12px;border:1px solid #78424b;border-radius:9px;color:#ffb7c0;font-size:12px}.ai-compose{position:relative;display:grid;grid-template-columns:1fr 44px;gap:10px;padding:16px;border-top:1px solid #28243c}.ai-compose textarea{resize:vertical;background:#171524;color:#f5f3ff;border:1px solid #38314e;border-radius:11px;padding:13px;font:inherit;font-size:13px;min-width:0}.ai-compose button{border:0;border-radius:11px;background:#8a60ee;color:white;display:grid;place-items:center;cursor:pointer}.ai-compose button:disabled{opacity:.45;cursor:not-allowed}.ai-compose small{grid-column:1/-1;color:#77718e;font-size:10px}.ai-spin{animation:aispin 1s linear infinite}@keyframes aispin{to{transform:rotate(360deg)}}@media(max-width:850px){.ai-layout{grid-template-columns:1fr;padding:30px 18px;gap:26px}.ai-intro h1{font-size:48px}.ai-messages{max-height:none;min-height:320px}.ai-status{display:none}.ai-topbar{padding:0 18px}}
