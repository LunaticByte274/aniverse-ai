,169,255,.17);border-radius:12px;padding:0 14px;min-width:155px}.discover-section{margin-top:30px}.discover-section-heading{display:flex;align-items:center;gap:13px;margin-bottom:17px}.discover-section-icon{width:40px;height:40px;border:1px solid #393054;background:#19152a;border-radius:13px;display:grid;place-items:center;color:#c2aaff}.discover-section-heading h2{font:650 21px 'Space Grotesk',sans-serif;letter-spacing:-.03em;margin:0 0 4px}.discover-section-heading p{font-size:12px;color:#9693b1;margin:0}.discover-count{margin-left:auto;color:#9e98bf;background:#171528;border:1px solid #302945;padding:4px 9px;border-radius:8px;font-size:11px}.discover-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.discover-card{min-width:0;background:linear-gradient(145deg,#141522,#0e0f19);border:1px solid rgba(175,169,255,.13);border-radius:15px;overflow:hidden;transition:transform .2s,border-color .2s,box-shadow .2s}.discover-card:hover{transform:translateY(-3px);border-color:rgba(167,139,250,.5);box-shadow:0 14px 36px #0003}.discover-poster{height:235px;position:relative;background:linear-gradient(135deg,#292342,#141522);overflow:hidden}.discover-poster>img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s}.discover-card:hover .discover-poster>img{transform:scale(1.04)}.discover-no-poster{height:100%;display:grid;place-items:center;color:#b5a0ff}.discover-format,.discover-score{position:absolute;top:10px;border-radius:7px;background:#090a12d9;border:1px solid #ffffff20;padding:5px 7px;font-size:9px;font-weight:700;letter-spacing:.04em}.discover-format{left:10px;color:#e7ddff}.discover-score{right:10px;display:flex;align-items:center;gap:4px;color:#ffd58a}.discover-add{position:absolute;right:10px;bottom:10px;width:36px;height:36px;border:1px solid #ffffff32;border-radius:11px;background:#8b5cf6;color:white;display:grid;place-items:center;box-shadow:0 5px 18px #0005}.discover-add.is-added{background:#164832;color:#86efac}.