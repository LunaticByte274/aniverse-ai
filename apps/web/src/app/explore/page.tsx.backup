"use client";
import { useEffect, useMemo, useState } from "react";
import Link from "next/link";
import { ArrowLeft, BookmarkPlus, Check, Flame, LoaderCircle, Search, Sparkles, Star, Tv, ExternalLink } from "lucide-react";
import "./explore.css";

type Title = { source: string; sourceId: string; malId?: number | null; title: string; englishTitle?: string | null; synopsis?: string | null; coverImage?: string | null; bannerImage?: string | null; totalEpisodes?: number | null; genres: string[]; averageScore?: number | null; popularity?: number | null; seasonYear?: number | null; format?: string | null; mediaStatus?: string | null };
type Payload = { trending: Title[]; seasonal: Title[]; upcoming: Title[]; season: string; year: number };
const seasonNames: Record<string,string> = { WINTER: "Winter", SPRING: "Spring", SUMMER: "Summer", FALL: "Fall" };
export default function ExplorePage() {
  const [data, setData] = useState<Payload | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [query, setQuery] = useState("");
  const [genre, setGenre] = useState("All genres");
  const [added, setAdded] = useState<string[]>([]);
  const [adding, setAdding] = useState<string>("");
  const [notice, setNotice] = useState("");
  useEffect(() => { fetch("/api/discover", { cache: "no-store" }).then(async r => { const body = await r.json(); if (!r.ok) throw new Error(body.error || "Discovery failed"); setData(body); }).catch(e => setError(e.message || "Discovery failed")).finally(() => setLoading(false)); }, []);
  const genres = useMemo(() => ["All genres", ...Array.from(new Set((data?.trending ?? []).flatMap(x => x.genres))).sort()], [data]);
  const filter = (items: Title[]) => items.filter(x => (genre === "All genres" || x.genres.includes(genre)) && (!query.trim() || `${x.title} ${x.englishTitle ?? ""} ${x.genres.join(" ")}`.toLowerCase().includes(query.toLowerCase())));
  async function add(title: Title) {
    setAdding(title.sourceId); setNotice("");
    try { const res = await fetch("/api/anime", { method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify({ title:title.title, englishTitle:title.englishTitle, synopsis:title.synopsis, coverImage:title.coverImage, totalEpisodes:title.totalEpisodes, genres:title.genres, source:title.source, sourceId:title.sourceId, malId:title.malId }) }); const body = await res.json(); if (!res.ok) throw new Error(body.error || "Could not add anime"); setAdded(old => old.includes(title.sourceId) ? old : [...old,title.sourceId]); setNotice(`${title.englishTitle || title.title} is in your library.`); }
    catch(e) { setNotice(e instanceof Error ? e.message : "Could not add anime"); } finally { setAdding(""); }
  }
  function section(title:string, subtitle:string, items:Title[], icon:React.ReactNode) { const visible = filter(items); return <section className="discover-section"><div className="discover-section-heading"><div className="discover-section-icon">{icon}</div><div><h2>{title}</h2><p>{subtitle}</p></div><span className="discover-count">{visible.length}</span></div>{visible.length ? <div className="discover-grid">{visible.map(item => <article className="discover-card" key={item.sourceId}><div className="discover-poster">{item.coverImage ? <img src={item.coverImage} alt={`${item.title} poster`} loading="lazy"/> : <div className="discover-no-poster"><Sparkles/></div>}<span className="discover-format">{(item.format || "ANIME").replaceAll("_"," ")}</span>{item.averageScore ? <span className="discover-score"><Star size={12} fill="currentColor"/> {item.averageScore}%</span> : null}<button className={`discover-add ${added.includes(item.sourceId) ? "is-added" : ""}`} onClick={() => void add(item)} disabled={adding === item.sourceId || added.includes(item.sourceId)} aria-label={`Add ${item.title} to library`}>{adding === item.sourceId ? <LoaderCircle className="discover-spin" size={17}/> : added.includes(item.sourceId) ? <Check size={17}/> : <BookmarkPlus size={17}/>}</button></div><div className="discover-card-body"><h3 title={item.englishTitle || item.title}>{item.englishTitle || item.title}</h3><p className="discover-romaji">{item.title}</p><div className="discover-meta">{item.totalEpisodes ? `${item.totalEpisodes} eps` : "Episode count TBA"}{item.seasonYear ? ` · ${item.seasonYear}` : ""}{item.popularity ? ` · ${item.popularity.toLocaleString()} fans` : ""}</div><div className="discover-genres">{item.genres.slice(0,3).map(g => <span key={g}>{g}</span>)}</div><p className="discover-synopsis">{(item.synopsis || "No synopsis available.").replace(/<[^>]*>/g," ").slice(0,150)}{(item.synopsis || "").length > 150 ? "…" : ""}</p><a className="discover-add-label" href={`https://reanime.to/search?query=${encodeURIComponent(`${item.englishTitle || item.title} episode 1`)}`} target="_blank" rel="noreferrer"><ExternalLink size={14}/> Watch on Re:Anime</a><button className="discover-add-label" disabled={adding === item.sourceId || added.includes(item.sourceId)} onClick={() => void add(item)}>{added.includes(item.sourceId) ? <><Check size={14}/> Added to library</> : adding === item.sourceId ? <><LoaderCircle className="discover-spin" size={14}/> Adding…</> : <><BookmarkPlus size={14}/> Add to library</>}</button></div></article>)}</div> : <div className="discover-empty">No titles match these filters. Try another genre or search term.</div>}</section>; }
  return <main className="explore-page"><header className="explore-topbar"><Link href="/" className="explore-back"><ArrowLeft size={16}/> Back to library</Link><div className="explore-brand"><span><Sparkles size={17}/></span> ANIVERSE <b>DISCOVER</b></div><div className="explore-source"><span/> Live AniList data</div></header><div className="explore-content"><div className="explore-intro"><div className="explore-eyebrow"><Sparkles size={14}/> YOUR NEXT OBSESSION STARTS HERE</div><h1>Find your <span>next universe.</span></h1><p>Explore what's trending, discover the current season, and add your next watch in one click.</p><div className="explore-controls"><label className="explore-search"><Search size={18}/><input value={query} onChange={e=>setQuery(e.target.value)} placeholder="Search titles, genres…"/><kbd>⌘ K</kbd></label><select value={genre} onChange={e=>setGenre(e.target.value)} aria-label="Filter by genre">{genres.map(g=><option key={g}>{g}</option>)}</select></div></div>{notice && <div className="explore-notice">{notice}</div>}{loading && <div className="explore-loading"><LoaderCircle className="discover-spin" size={24}/> Loading live anime discovery…</div>}{error && <div className="explore-error"><strong>Could not load anime right now.</strong><p>{error}</p><button onClick={()=>{setLoading(true);setError("");fetch("/api/discover",{cache:"no-store"}).then(async r=>{const b=await r.json();if(!r.ok)throw new Error(b.error);setData(b)}).catch(e=>setError(e.message||"Discovery failed")).finally(()=>setLoading(false));}}>Try again</button></div>}{data && !loading && <>{section("Trending now","Popular anime fans are watching and talking about.",data.trending,<Flame size={19}/>)}{section(`${seasonNames[data.season] || data.season} ${data.year}`,"Anime for the current season, sourced from AniList.",data.seasonal,<Tv size={19}/>)}{data.upcoming.length > 0 && section("Coming soon","Popular titles marked as not yet released.",data.upcoming,<Sparkles size={19}/>)}</>}<footer className="explore-footer">Metadata and rankings provided by AniList. Availability and episode counts can change.</footer></div></main>;
}
